#!/usr/bin/env bash

# Basic bar
sketchybar --bar \
  position=top \
  height=32 \
  color=0xff1e1e2e \
  shadow=off \
  sticky=on \
  padding_left=8 \
  padding_right=8

# Defaults for all items
sketchybar --default \
  icon.color=0xffcdd6f4 \
  label.color=0xffcdd6f4 \
  icon.font="SF Pro:Semibold:13.0" \
  label.font="SF Pro:Semibold:13.0" \
  padding_left=8 \
  padding_right=8

# AeroSpace workspace event
sketchybar --add event aerospace_workspace_change

# Workspace items
for sid in 1 2 3 4 5 6 7 8 9 I M O P U; do
  sketchybar --add item "space.$sid" left \
    --set "space.$sid" \
      icon="$sid" \
      label.drawing=off \
      click_script="aerospace workspace $sid" \
      script="$HOME/.config/sketchybar/aerospace.sh $sid" \
    --subscribe "space.$sid" aerospace_workspace_change
done

# Clock
sketchybar --add item clock right \
  --set clock \
    update_freq=10 \
    script='sketchybar --set clock label="$(date "+%a %b %d  %I:%M %p")"'

# Initial refresh
sketchybar --trigger aerospace_workspace_change
