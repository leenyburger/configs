#!/usr/bin/env bash

# shellcheck source=colors.sh
source "$CONFIG_DIR/colors.sh"

PLUGIN_DIR="$CONFIG_DIR/plugins"

# --- Bar appearance ---------------------------------------------------------
sketchybar --bar \
  position=top \
  height=32 \
  color="$BAR_COLOR" \
  corner_radius=0 \
  shadow=off \
  sticky=on \
  padding_left=8 \
  padding_right=8

# --- Defaults for all items -------------------------------------------------
sketchybar --default \
  icon.color="$TEXT" \
  label.color="$TEXT" \
  icon.font="SF Pro:Semibold:13.0" \
  label.font="SF Pro:Semibold:13.0" \
  padding_left=8 \
  padding_right=8

# --- Events ------------------------------------------------------------------
sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_mode_change

# --- Mode indicator (left, before workspaces) -------------------------------
# Hidden by default; aerospace.toml triggers this with MODE=service /
# MODE=main whenever it switches modes (see aerospace_mode_change plugin).
sketchybar --add item mode left \
  --set mode \
    drawing=off \
    icon.drawing=off \
    label.font="SF Pro:Bold:12.0" \
    label.color="$BASE" \
    label.padding_left=8 \
    label.padding_right=8 \
    background.drawing=on \
    background.color="$PEACH" \
    background.corner_radius=6 \
    background.height=22 \
    script="$PLUGIN_DIR/mode.sh" \
  --subscribe mode aerospace_mode_change

# --- Workspaces (left) -------------------------------------------------------
for sid in 1 2 3 4 5 6 7 8 9 I M O P U; do
  sketchybar --add item "space.$sid" left \
    --set "space.$sid" \
      icon="$sid" \
      label.drawing=off \
      click_script="aerospace workspace $sid" \
      script="$PLUGIN_DIR/aerospace.sh $sid" \
    --subscribe "space.$sid" aerospace_workspace_change
done

# --- front_app (left, after workspaces) -------------------------------------
# Icons need the sketchybar-app-font (https://github.com/kvndrsslr/sketchybar-app-font)
# plus its generated icon_map.sh helper. Detect once at load time so
# front_app.sh can degrade to plain text when either isn't installed.
if fc-list | grep -qi "sketchybar-app-font"; then
  echo "1" > /tmp/sketchybar_app_font_available
else
  echo "0" > /tmp/sketchybar_app_font_available
fi

sketchybar --add item front_app left \
  --set front_app \
    icon.drawing=off \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

# --- clock (right) -----------------------------------------------------------
sketchybar --add item clock right \
  --set clock \
    update_freq=10 \
    script='sketchybar --set clock label="$(date "+%a %b %d  %I:%M %p")"'

# --- battery (right) ---------------------------------------------------------
sketchybar --add item battery right \
  --set battery \
    update_freq=120 \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

# --- volume (right) -----------------------------------------------------------
sketchybar --add item volume right \
  --set volume \
    script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

# --- Initial paint ------------------------------------------------------------
# Forces every item's script to run once so the bar isn't blank on launch.
sketchybar --trigger aerospace_workspace_change
sketchybar --update
